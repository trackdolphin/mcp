{
  "name": "@trackdolphin/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "trackdolphin": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --banner:js='#!/usr/bin/env node' --outfile=dist/index.js && chmod +x dist/index.js",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@trackdolphin/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "esbuild": "0.25.10",
    "@trackdolphin/openapi-client": "workspace:*"
  },
  "description": "Trackdolphin auf der Kommandozeile: jeder API-Endpunkt ein Befehl, abgeleitet aus der OpenAPI-Beschreibung.",
  "license": "MIT",
  "homepage": "https://trackdolphin.com/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trackdolphin/mcp.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "trackdolphin",
    "server-side-tracking",
    "meta-capi",
    "google-ads",
    "cli"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Trackdolphin",
    "url": "https://trackdolphin.com"
  }
}
